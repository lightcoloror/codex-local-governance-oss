{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "closure_run_id", "task_id", "objective", "status", "execution_profile", "tool_id", "request_sha256", "input_refs", "execution_slice", "handoff", "stage_receipt", "failure_point", "resume_entry", "approval_boundary", "stop_conditions", "steps", "budgets", "stop_codes", "silent_fallback_allowed", "execution_authorized", "payload_sha256"],
  "properties": {
    "schema_version": {"const": "local-tool-task-capsule.v1"},
    "contract_version": {"const": "small-model-task-capsule-foundation.v1"},
    "closure_run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,119}$"},
    "task_id": {"type": "string"},
    "objective": {"type": "string", "maxLength": 3000},
    "status": {"const": "preflight_ready"},
    "execution_profile": {
      "type": "object", "additionalProperties": false, "required": ["model", "reasoning"],
      "properties": {"model": {"const": "gpt-5.6-luna"}, "reasoning": {"const": "low"}}
    },
    "tool_id": {"type": "string"},
    "request_sha256": {"$ref": "#/$defs/sha"},
    "input_refs": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/ref"}},
    "execution_slice": {"$ref": "#/$defs/ref"},
    "handoff": {"$ref": "#/$defs/ref"},
    "stage_receipt": {
      "type": "object", "additionalProperties": false, "required": ["stage_id", "status", "schema_version"],
      "properties": {"stage_id": {"const": "static-doctor"}, "status": {"const": "pending"}, "schema_version": {"const": "local-tool-task-receipt.v1"}}
    },
    "failure_point": {"type": "null"},
    "resume_entry": {"type": "string", "minLength": 5, "maxLength": 512},
    "approval_boundary": {"const": "native_gate_preserved"},
    "stop_conditions": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"type": "string"}},
    "steps": {
      "type": "array", "minItems": 1, "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["step_id", "action", "stop_on_error"],
        "properties": {"step_id": {"type": "string"}, "action": {"const": "run_exact_slice_command"}, "stop_on_error": {"const": true}}
      }
    },
    "budgets": {
      "type": "object", "additionalProperties": false,
      "required": ["capsule_max_bytes", "slice_max_bytes", "handoff_max_bytes", "receipt_max_bytes", "max_steps", "max_tool_calls", "max_retries", "execution_objects"],
      "properties": {
        "capsule_max_bytes": {"const": 4096}, "slice_max_bytes": {"const": 1536}, "handoff_max_bytes": {"const": 3072}, "receipt_max_bytes": {"const": 2048},
        "max_steps": {"const": 5}, "max_tool_calls": {"const": 1}, "max_retries": {"const": 0}, "execution_objects": {"const": 1}
      }
    },
    "stop_codes": {"type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true, "items": {"type": "string"}},
    "silent_fallback_allowed": {"const": false},
    "execution_authorized": {"const": false},
    "payload_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ref": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?![A-Za-z]:[\\\\/])(?!/)(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"},
        "sha256": {"$ref": "#/$defs/sha"}
      }
    }
  }
}
