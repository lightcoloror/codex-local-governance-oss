{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-tool-compact-selector-stage2.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "catalog_snapshot",
    "selection_scope",
    "decision",
    "candidates",
    "unknown_boundary",
    "approval_boundary",
    "drift_check",
    "execution_authorized"
  ],
  "properties": {
    "schema_version": {"const": "agent-tool-compact-selector-stage2.v1"},
    "request_id": {"type": "string", "minLength": 1},
    "catalog_snapshot": {"type": "object"},
    "selection_scope": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "string"}},
    "decision": {"enum": ["candidates_returned", "not_found"]},
    "candidates": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool_id",
          "owner_lane",
          "purpose",
          "compact_refs",
          "risk_tier",
          "contract_ready",
          "current_online",
          "approval_mode"
        ],
        "properties": {
          "tool_id": {"type": "string", "minLength": 1},
          "owner_lane": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "compact_refs": {
            "type": "object",
            "additionalProperties": false,
            "required": ["card", "doctor", "discovery"],
            "properties": {
              "card": {"type": "string", "minLength": 1},
              "doctor": {"type": "string", "minLength": 1},
              "discovery": {"type": ["string", "null"]}
            }
          },
          "risk_tier": {"type": "string", "minLength": 1},
          "contract_ready": {"type": "object"},
          "current_online": {"type": "object"},
          "approval_mode": {"type": "string", "minLength": 1}
        }
      }
    },
    "unknown_boundary": {"type": "string", "minLength": 1},
    "approval_boundary": {"type": "string", "minLength": 1},
    "drift_check": {"type": "string", "minLength": 1},
    "execution_authorized": {"const": false},
    "payload_bytes": {"type": "integer", "minimum": 1, "maximum": 6144}
  }
}
