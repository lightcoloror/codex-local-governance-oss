{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "closure_run_id", "task_id", "stage_id", "tool_id", "execution_slice", "input_refs", "receipt_schema", "observation_contract", "failure_point", "resume_entry", "approval_boundary", "stop_conditions", "auto_retry", "payload_sha256"],
  "properties": {
    "schema_version": {"const": "local-tool-step-handoff.v1"},
    "contract_version": {"const": "small-model-task-capsule-foundation.v1"},
    "closure_run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,119}$"},
    "task_id": {"type": "string"},
    "stage_id": {"enum": ["static-doctor", "allowlisted-action"]},
    "tool_id": {"type": "string"},
    "execution_slice": {"$ref": "#/$defs/ref"},
    "input_refs": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/ref"}},
    "receipt_schema": {"enum": ["local-tool-task-receipt.v1", "local-tool-action-receipt.v1"]},
    "observation_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "required_fields", "decision_values", "boundary_fields"],
      "properties": {
        "schema_version": {"enum": ["local-tool-blind-observation.v1", "local-tool-action-observation.v1"]},
        "required_fields": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string"}},
        "decision_values": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["passed", "blocked", "escalated"]}},
        "boundary_fields": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string"}},
        "template": {"type": "object"}
      }
    },
    "failure_point": {"type": "null"},
    "resume_entry": {"type": "string", "minLength": 5, "maxLength": 512},
    "approval_boundary": {"const": "native_gate_preserved"},
    "stop_conditions": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"type": "string"}},
    "auto_retry": {"const": 0},
    "payload_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ref": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?![A-Za-z]:[\\\\/])(?!/)(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"},
        "sha256": {"$ref": "#/$defs/sha"}
      }
    }
  }
}
