{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profiles", "execution_authorized"],
  "properties": {
    "schema_version": {"const": "local-tool-action-profile-catalog.v1"},
    "execution_authorized": {"const": false},
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/profile"}
    }
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "tool_id", "interface_id", "contract_ref", "contract_sha256", "executable", "argv", "working_directory", "environment", "timeout_seconds", "expected_json", "fixed_input_refs", "output_policy", "boundaries"],
      "properties": {
        "action_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{4,95}$"},
        "tool_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
        "interface_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
        "contract_ref": {"type": "string", "pattern": "^\\$\\{LOCAL_TOOLS_WORKSPACE_ROOT\\}/"},
        "contract_sha256": {"$ref": "#/$defs/sha"},
        "executable": {"enum": ["python", "node", "powershell"]},
        "argv": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 300}},
        "working_directory": {"enum": ["{workspace_root}", "{registry_path}"]},
        "environment": {"type": "object", "maxProperties": 8, "additionalProperties": {"type": "string", "maxLength": 300}},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 60},
        "expected_json": {
          "type": "array", "minItems": 1, "maxItems": 8,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["path"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "equals": {},
              "one_of": {"type": "array", "minItems": 1, "maxItems": 8}
            },
            "oneOf": [{"required": ["equals"]}, {"required": ["one_of"]}]
          }
        },
        "fixed_input_refs": {
          "type": "array", "maxItems": 8,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
            "properties": {"path": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha"}}
          }
        },
        "output_policy": {
          "type": "object", "additionalProperties": false,
          "required": ["mode", "allowed_extensions", "max_bytes"],
          "properties": {
            "mode": {"enum": ["runner_receipt_only", "workspace_output_only"]},
            "allowed_extensions": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^\\.[a-z0-9]+$"}},
            "max_bytes": {"type": "integer", "minimum": 1024, "maximum": 8388608}
          }
        },
        "boundaries": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"type": "string"}},
        "authority_class": {"enum": ["bounded_action", "preflight_only"]},
        "approval_required_for_real_action": {"type": "boolean"}
      }
    }
  }
}
