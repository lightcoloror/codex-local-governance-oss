{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool_id", "interface_id", "command", "io", "boundaries", "timeout_seconds", "error_codes", "registry_entry_sha256", "discovery_sha256", "catalog_semantic_sha256", "full_card_ref", "payload_sha256"],
  "properties": {
    "schema_version": {"const": "agent-tool-execution-slice.v1"},
    "tool_id": {"type": "string"},
    "interface_id": {"const": "catalog_static_doctor"},
    "command": {"type": "string", "pattern": "^python scripts/local_tools.py agent-catalog doctor [a-z0-9._-]+$", "maxLength": 180},
    "io": {
      "type": "object", "additionalProperties": false, "required": ["input", "output"],
      "properties": {"input": {"const": "catalog+registry+discovery"}, "output": {"type": "string"}}
    },
    "boundaries": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"type": "string"}},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 30},
    "error_codes": {"type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true, "items": {"type": "string"}},
    "registry_entry_sha256": {"$ref": "#/$defs/sha"},
    "discovery_sha256": {"$ref": "#/$defs/sha"},
    "catalog_semantic_sha256": {"$ref": "#/$defs/sha"},
    "full_card_ref": {"type": "string", "pattern": "^agent-tool-catalog://[a-f0-9]{64}/"},
    "payload_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {"sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
