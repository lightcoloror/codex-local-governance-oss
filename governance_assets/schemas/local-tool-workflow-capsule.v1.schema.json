{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workflow_id", "template_id", "objective", "status", "execution_profile", "runner_mode", "request", "template_catalog", "source_fingerprints", "input_refs", "stages", "final_artifacts", "boundaries", "budgets", "stop_condition", "execution_authorized", "payload_sha256"],
  "properties": {
    "schema_version": {"const": "local-tool-workflow-capsule.v1"},
    "workflow_id": {"type": "string"},
    "template_id": {"type": "string"},
    "objective": {"type": "string", "maxLength": 2000},
    "status": {"const": "preflight_ready"},
    "execution_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "reasoning"],
      "properties": {"model": {"const": "gpt-5.6-luna"}, "reasoning": {"const": "low"}}
    },
    "runner_mode": {"const": "deterministic_control_plane"},
    "request": {"$ref": "#/$defs/ref"},
    "template_catalog": {"$ref": "#/$defs/ref"},
    "source_fingerprints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_registry_sha256", "source_inventory_sha256", "agent_catalog_semantic_sha256", "action_profile_catalog_sha256"],
      "properties": {
        "tool_registry_sha256": {"$ref": "#/$defs/sha"},
        "source_inventory_sha256": {"$ref": "#/$defs/sha"},
        "agent_catalog_semantic_sha256": {"$ref": "#/$defs/sha"},
        "action_profile_catalog_sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "input_refs": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/ref"}},
    "stages": {"type": "array", "minItems": 2, "maxItems": 8, "items": {"type": "object"}},
    "final_artifacts": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "object"}},
    "boundaries": {"type": "object"},
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_stages", "max_stage_attempts", "max_model_escalations", "automatic_catalog_refreshes"],
      "properties": {
        "max_stages": {"type": "integer", "minimum": 2, "maximum": 8},
        "max_stage_attempts": {"const": 2},
        "max_model_escalations": {"const": 1},
        "automatic_catalog_refreshes": {"const": 1}
      }
    },
    "stop_condition": {"type": "string"},
    "execution_authorized": {"const": false},
    "payload_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha"}}
    }
  }
}
